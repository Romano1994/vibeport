# Database
DB_CONTAINER_NAME=vibeport-db
DB_DATABASE=vibeport
DB_USERNAME=vibeport
DB_ROOT_PASSWORD=change-me
DB_PASSWORD=change-me

# Backend
BACKEND_CONTAINER_NAME=vibeport-backend
BACKEND_PORT=8081
SPRING_DATASOURCE_URL=jdbc:log4jdbc:mariadb://db:3306/vibeport?serverTimezone=Asia/Seoul
SPRING_AI_GEMINI_CHAT_OPTIONS_TIMEOUT=180s

# Frontend
FRONTEND_CONTAINER_NAME=vibeport-frontend
FRONTEND_PORT=80
REACT_APP_API_BASE_URL=/vibeport

# Runtime
TZ=Asia/Seoul

# JWT
JWT_SECRET=change-me

# AI API
OPENAI_API_KEY=your-openai-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key
GEMINI_API_KEY=your-gemini-api-key

# AWS SES
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key

# SerpAPI
SERPAPI_API_KEY=your-serpapi-api-key
