# Database
DB_CONTAINER_NAME=vibeport-db
DB_DATABASE=vibeport
DB_ROOT_PASSWORD=change-me
SPRING_DATASOURCE_URL=jdbc:log4jdbc:mariadb://db:3306/vibeport?serverTimezone=Asia/Seoul
SPRING_DATASOURCE_USERNAME=vibeport
SPRING_DATASOURCE_PASSWORD=change-me

# Backend
BACKEND_CONTAINER_NAME=vibeport-backend
BACKEND_PORT=8081

# Frontend
FRONTEND_CONTAINER_NAME=vibeport-frontend
FRONTEND_PORT=80
REACT_APP_API_BASE_URL=/vibeport

# Runtime
TZ=Asia/Seoul

# JWT
JWT_SECRET=change-me
JWT_EXPIRATION_ACCESS=900000
JWT_EXPIRATION_REFRESH=86400000

# SMTP Mail
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_FROM=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_ERROR_EMAIL=

# AI API
OPENAI_API_KEY=your-openai-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key
GEMINI_API_KEY=your-gemini-api-key
SPRING_AI_GEMINI_API_KEY=
SPRING_AI_GEMINI_CHAT_OPTIONS_TIMEOUT=180s
SPRING_AI_OPENAI_BASE_URL=https://api.perplexity.ai
SPRING_AI_OPENAI_CHAT_COMPLETIONS_PATH=/chat/completions
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=sonar-pro
SPRING_AI_OPENAI_CHAT_OPTIONS_TEMPERATURE=0.0
SPRING_AI_OPENAI_CHAT_OPTIONS_MAX_TOKENS=4096
SPRING_AI_OPENAI_CHAT_OPTIONS_CONNECT_TIMEOUT=30000
SPRING_AI_OPENAI_CHAT_OPTIONS_READ_TIMEOUT=120000
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_RESPONSES_MODEL=gpt-4.1

# AWS SES
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_SES_SEND_MAIL_FROM=
AWS_REGION=ap-northeast-1

# SerpAPI
SERPAPI_API_KEY=your-serpapi-api-key

# Newsletter
NEWSLETTER_LAUNCH_DATE=2026-05-01
NEWSLETTER_SEND_TIME_TEXT=09:00

# App
APP_IMAGE_DIR=./data/concert_images/
APP_PUBLIC_BASE_URL=

# Batch
BATCH_GEMINI_CONCERT_ENABLED=false
BATCH_GEMINI_CONCERT_CRON=0 30 8 * * *
BATCH_DAILY_PIPELINE_ENABLED=true
BATCH_DAILY_PIPELINE_CRON=0 30 8 * * *
BATCH_DAILY_CONCERT_COLLECTION_ENABLED=true
BATCH_DAILY_CONCERT_COLLECTION_CRON=0 0 6 * * *
BATCH_DAILY_CONCERT_COLLECTION_ZONE=Asia/Seoul
BATCH_DAILY_NEWSLETTER_ENABLED=true
BATCH_DAILY_NEWSLETTER_CRON=0 30 8 * * *
BATCH_DAILY_NEWSLETTER_ZONE=Asia/Seoul
BATCH_MISSING_CONCERT_INFO_ENABLED=true
BATCH_MISSING_CONCERT_INFO_CRON=0 0 5 * * *
BATCH_MISSING_CONCERT_INFO_ZONE=Asia/Seoul
